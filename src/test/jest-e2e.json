{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "../",
  "testRegex": ".e2e.spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.json"
      }
    ]
  },
  "collectCoverageFrom": [
    "**/*.(t|j)s"
  ],
  "coverageDirectory": "../coverage",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "@/common/(.*)$": "<rootDir>/common/$1",
    "@/settings/(.*)$": "<rootDir>/settings/$1",
    "@/films/(.*)$": "<rootDir>/modules/cinema/film/$1",
    "@/cartoons/(.*)$": "<rootDir>/modules/cinema/cartoon/$1",
    "@/serials/(.*)$": "<rootDir>/modules/cinema/serial/$1",
    "@/movies/(.*)$": "<rootDir>/modules/cinema/movies/$1",
    "@/data-migrations/(.*)$": "<rootDir>/migrations/data-migration/$1",
    "@/admin/(.*)$": "<rootDir>/modules/admin/$1",
    "@/bcrypt-module/(.*)$": "<rootDir>/modules/bcrypt/$1",
    "@/admin-auth/(.*)$": "<rootDir>/modules/auth/admin/$1",
    "@/external-auth/(.*)$": "<rootDir>/modules/auth/external/$1",
    "@/sessions/(.*)$": "<rootDir>/modules/auth/session/$1",
    "@/jwt-module/(.*)$": "<rootDir>/modules/jwt/$1",
    "@/external-api/(.*)$": "<rootDir>/modules/external-api/$1",
    "@/converter-logs/(.*)$": "<rootDir>/modules/converter-logs/$1",
    "@/banned-providers-movie/(.*)$": "<rootDir>/modules/banned-providers-movie/$1",
    "@/moderation-movie/(.*)$": "<rootDir>/modules/moderation-movie/$1",
    "@/telegram/(.*)$": "<rootDir>/modules/telegram/$1",
    "@/telegram-admin-bot/(.*)$": "<rootDir>/modules/telegram/admin-bot/$1"
  }
}